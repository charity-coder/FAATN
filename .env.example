# --- First administrator (required; there is no default password) ---
ADMIN_EMAIL=faatnigeria@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=FAATN Administrator

SECRET_KEY=
PUBLIC_SITE_URL=https://faatn-gate.com

# --- Email: set MAIL_FROM plus ONE of the three options ---
# Use an address on your own domain once you have verified faatn-gate.com with Brevo/Resend;
# until then use a sender address you verified (for example your Gmail).
MAIL_FROM=no-reply@faatn-gate.com
MAIL_FROM_NAME=FAATN-GATE
MAIL_REPLY_TO=faatnigeria@gmail.com
# A) Brevo HTTPS API (works on Render free)
BREVO_API_KEY=
# B) Resend HTTPS API (needs a verified domain)
RESEND_API_KEY=
# C) SMTP with Gmail (needs an App password; blocked on Render free)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=faatnigeria@gmail.com
MAIL_PASSWORD=
# MAIL_USE_SSL=1   # only with port 465

# Optional: alert email for new sign-ups / help requests
ADMIN_NOTIFY_EMAIL=faatnigeria@gmail.com
